{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATENA",
  "version": "0.2.2",
  "identifier": "io.github.tarzanislav.atena",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ATENA",
        "width": 1320,
        "height": 880,
        "minWidth": 920,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "media-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'",
        "media-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "The ATENA contributors",
    "copyright": "Apache-2.0 – the ATENA contributors",
    "category": "Education",
    "shortDescription": "Verified information about education",
    "longDescription": "ATENA collects information about education from open sources only, lawfully and safely, and makes it searchable in five languages.",
    "homepage": "https://github.com/tarzanislav/atena",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/postgres/": "postgres/",
      "resources/notices/": "notices/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Slovak",
          "English",
          "Czech",
          "Russian",
          "SimpChinese"
        ],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Slovak": "nsis/Slovak.nsh",
          "Czech": "nsis/Czech.nsh"
        }
      }
    }
  }
}
